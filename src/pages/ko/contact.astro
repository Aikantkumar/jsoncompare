---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "홈", item: "https://jsoncompareonline.com/ko" }, { "@type": "ListItem", position: 2, name: "문의하기", item: "https://jsoncompareonline.com/ko/contact" } ] };
const contactSchema = { "@context": "https://schema.org", "@type": "ContactPage", name: "JSON Compare Online 문의", url: "https://jsoncompareonline.com/ko/contact", description: "기술 지원, 버그 보고, 기능 제안 또는 기업 규정 준수 문의를 위해 JSON Compare Online 팀에 문의하세요." };
---
<Layout lang="ko" title="문의하기 — 기술 지원 및 피드백 | JSON Compare Online" description="버그 보고, 알고리즘 제안, 기능 요청 또는 기업 규정 준수 문의를 위해 JSON Compare Online 팀에 문의하세요." canonicalPath="/contact" activeTab="contact" structuredData={[breadcrumbSchema, contactSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>개발자 지원</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">문의하기</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">AST 파서 경계 버그, 알고리즘 요청 또는 보안 규정 준수 문의가 있으신가요? 기꺼이 들어드리겠습니다.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🐛</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">버그 보고 및 문제</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">AST 파서 버그나 처리되지 않은 스키마 경계 사례를 찾으셨나요? 재현 가능한 예시 스니펫을 알려주세요.</p><a href="mailto:bugs@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">bugs@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">💡</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">기능 요청</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">새로운 변환기 형식, 사용자 지정 들여쓰기 옵션 또는 특정 JSONPath 필터 로직이 필요하신가요?</p><a href="mailto:features@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">features@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🛡️</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">보안 및 개인정보 보호</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">취약점 공개, 침투 테스트 문의 또는 기업 개인정보 보호 감사:</p><a href="mailto:security@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">security@jsoncompareonline.com</a></div>
      </div>
      <div class="md:col-span-2">
        <div class="p-6 sm:p-8 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
          <h2 class="text-lg font-bold text-[#111111] dark:text-[#f0f0f2] mb-1">메시지를 보내주세요</h2>
          <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mb-6">아래 양식을 작성해 주세요. 개발자 팀은 보통 24~48시간 이내에 답변합니다.</p>
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label for="contact-name" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">이름 *</label><input type="text" id="contact-name" name="name" required placeholder="예: Alex Chen" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
              <div><label for="contact-email" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">이메일 주소 *</label><input type="email" id="contact-email" name="email" required placeholder="alex@company.com" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
            </div>
            <div><label for="contact-category" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">주제 / 카테고리</label><select id="contact-category" name="category" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors"><option value="General Feedback">일반 피드백</option><option value="Bug Report">버그 보고 / 파서 문제</option><option value="Feature Suggestion">기능 제안</option><option value="Security & Compliance">보안 및 규정 준수</option><option value="Partnership">파트너십 / API 문의</option></select></div>
            <div><label for="contact-message" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">메시지 *</label><textarea id="contact-message" name="message" rows="5" required placeholder="질문, 기능 아이디어 또는 오류 세부 정보를 설명해 주세요..." class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors resize-y"></textarea></div>
            <div id="contact-status" class="hidden p-3 rounded-xl text-xs font-medium"></div>
            <button type="submit" id="contact-submit" class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors cursor-pointer">메시지 전송</button>
          </form>
        </div>
      </div>
    </div>
    <script is:inline>(function(){const form=document.getElementById('contact-form');const statusBox=document.getElementById('contact-status');const submitBtn=document.getElementById('contact-submit');if(!form||!statusBox||!submitBtn)return;form.addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('contact-name').value.trim();const email=document.getElementById('contact-email').value.trim();const category=document.getElementById('contact-category').value;const message=document.getElementById('contact-message').value.trim();if(!name||!email||!message){statusBox.className='p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300 block';statusBox.textContent='모든 필수 항목을 입력해 주세요.';return;}submitBtn.disabled=true;submitBtn.textContent='전송 중...';setTimeout(()=>{statusBox.className='p-3 rounded-xl text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 block';statusBox.innerHTML='<strong>감사합니다!</strong> 메시지가 준비되었습니다. 이메일 클라이언트가 자동으로 열리지 않으면 <a href="mailto:support@jsoncompareonline.com" class="underline font-bold">support@jsoncompareonline.com</a>로 직접 메일을 보낼 수 있습니다.';const subject=encodeURIComponent(`[${category}] ${name}님`);const body=encodeURIComponent(`이름: ${name}\n이메일: ${email}\n카테고리: ${category}\n\n메시지:\n${message}`);window.location.href=`mailto:support@jsoncompareonline.com?subject=${subject}&body=${body}`;form.reset();submitBtn.disabled=false;submitBtn.textContent='메시지 전송';},600);});})();</script>
  </div>
</Layout>
