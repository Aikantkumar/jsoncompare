---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "홈", item: "https://jsoncompareonline.com/ko" }, { "@type": "ListItem", position: 2, name: "자주 묻는 질문", item: "https://jsoncompareonline.com/ko/faq" } ] };
const faqs = [
  { q: "두 JSON 파일 비교하는 방법", a: "기준(왼쪽)과 수정된(오른쪽) JSON 문서를 온라인 JSON 비교 편집기에 붙여넣거나 \"파일 불러오기\"를 클릭하여 컴퓨터에서 .json 파일을 가져오세요. \"키 정렬\"을 활성화하여 키 순서를 무시한 후 디프를 실행하세요. 추가된 키는 초록색, 삭제된 속성은 빨간색, 수정된 값은 호박색으로 표시됩니다. 사이드바이사이드 보기와 통합 보기를 전환하고 감지된 모든 변경 사항에 대한 RFC 6902 JSON 패치를 1클릭으로 내보내세요." },
  { q: "JSON 차이란 무엇인가요?", a: "JSON 차이(JSON diff)는 두 JSON 문서를 비교하여 정확히 무엇이 변경되었는지 식별하는 과정입니다 — 추가된 키, 삭제된 키, 수정된 값, 타입 변경 및 배열 삽입 또는 삭제입니다. 시맨틱 JSON 디프는 문서를 단순 텍스트로 취급하는 대신 문서 구조를 구문 분석하므로 키 재정렬, 공백 변경 및 들여쓰기 차이는 위양성을 유발하지 않습니다." },
  { q: "JSON은 무엇에 가장 적합한가요?", a: "JSON(JavaScript Object Notation)은 웹 클라이언트와 서버 간의 가벼운 데이터 교환, REST API 요청 및 응답 페이로드, package.json 및 tsconfig.json 같은 구성 파일, NoSQL 문서 저장소 및 프런트엔드 애플리케이션 상태에 가장 적합합니다. 언어에 독립적이며 사람이 읽을 수 있고 모든 현대 프로그래밍 언어에서 기본적으로 지원됩니다." }
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---
<Layout lang="ko" title="JSON Compare FAQ | JSON Compare Online" description="시맨틱 JSON 비교 도구, RFC 6902 패치, JSON 키 정렬기, 클라이언트 측 개인정보 보호, JSON 변환기에 관한 자주 묻는 질문입니다." keywords="json compare faq, json 온라인 비교, 두 json 파일 비교 방법, json 차이, json 비교 도구, rfc 6902 json 패치, json 키 정렬기, json 타입스크립트, json 변환기, 클라이언트 측 json 비교" canonicalPath="/faq" activeTab="faq" structuredData={[breadcrumbSchema, faqSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>도움말 센터</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">자주 묻는 질문</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">시맨틱 디프 알고리즘, 개발자 도구, 보안 아키텍처, 데이터 변환기에 대해 알아야 할 모든 것을 확인하세요.</p>
    </div>
    <section class="space-y-4">{faqs.map((faq) => (<details class="group bg-white dark:bg-[#14161b] rounded-2xl border border-[#e5e5e5] dark:border-[#22242a] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer"><summary class="flex items-center justify-between font-semibold text-sm text-[#111111] dark:text-[#f0f0f2]"><span>{faq.q}</span><span class="ml-4 text-[#707072] dark:text-[#8e8e93] group-open:rotate-180 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span></summary><p class="mt-3 text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed border-t border-[#f5f5f5] dark:border-[#202228] pt-3">{faq.a}</p></details>))}</section>
    <section class="mt-12 p-6 sm:p-8 rounded-2xl border border-[#111111] dark:border-[#f0f0f2] flex flex-col sm:flex-row items-center justify-between gap-4"><div><h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2]">JSON 비교 준비가 되셨나요?</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-0.5">두 JSON 페이로드를 즉시 비교하세요 — 100% 클라이언트 측, 업로드 없음.</p></div><a href="/ko/" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors shrink-0">JSON 비교 도구 열기</a></section>
  </div>
</Layout>
