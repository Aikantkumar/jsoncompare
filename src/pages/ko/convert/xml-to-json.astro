---
import Layout from '../../../layouts/Layout.astro';
import ConverterApp from '../../../components/tools/ConverterApp';
---
<Layout lang="ko" title="온라인 XML → JSON 변환기 — 빠른 중첩 파서 및 검증기" description="XML 문자열 및 파일을 온라인으로 구조화된 JSON으로 변환하세요. 구문 검증, 네임스페이스 처리 및 즉시 클립보드 복사." activeTab="converters" canonicalPath="/convert/xml-to-json"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>DevOps 및 구성</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">XML → JSON 변환기</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">SOAP 엔드포인트, RSS 피드 및 레거시 엔터프라이즈 페이로드의 XML을 네트워크를 통해 데이터를 전송하지 않고 가볍고 현대적인 JSON으로 변환하세요.</p></div><ConverterApp client:load initialMode="xml-to-json" /></div></Layout>
