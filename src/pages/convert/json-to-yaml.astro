---
import Layout from '../../layouts/Layout.astro';
import ConverterApp from '../../components/tools/ConverterApp';
---

<Layout
  title="JSON to YAML Converter Online — Clean & Formatted Output"
  description="Convert JSON documents to YAML online. Automatically handles indentation, nested mappings, and arrays."
  activeTab="converters"
  canonicalPath="/convert/json-to-yaml"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] text-[11px] font-mono text-[#39393b] mb-3 border border-[#e5e5e5]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111]"></span>
        Format Converter
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] uppercase">
        JSON TO YAML CONVERTER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] max-w-2xl">
        Transform JSON payloads into standard YAML syntax for Docker Compose, CI/CD pipelines, and configuration files.
      </p>
    </div>

    <ConverterApp client:load initialMode="json-to-yaml" />
  </div>
</Layout>

