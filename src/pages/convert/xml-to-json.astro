---
import Layout from '../../layouts/Layout.astro';
import ConverterApp from '../../components/tools/ConverterApp';
---

<Layout
  title="XML to JSON Converter Online — Parse Attributes & Tag Trees"
  description="Convert XML documents into structured JSON objects online. Parses tags, child nodes, and XML attributes accurately."
  activeTab="converters"
  canonicalPath="/convert/xml-to-json"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] text-[11px] font-mono text-[#39393b] mb-3 border border-[#e5e5e5]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111]"></span>
        Format Converter
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] uppercase">
        XML TO JSON CONVERTER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] max-w-2xl">
        Convert legacy SOAP responses, RSS feeds, and XML files into JSON objects with automatic attribute preservation.
      </p>
    </div>

    <ConverterApp client:load initialMode="xml-to-json" />
  </div>
</Layout>

