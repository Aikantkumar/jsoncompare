---
import Layout from '../../layouts/Layout.astro';
import ConverterApp from '../../components/tools/ConverterApp';
---

<Layout
  title="XML to JSON Converter Online — Fast, Nested Parser & Schema Extractor"
  description="Convert XML documents to clean JSON objects online. Preserves nested tags, values, and attributes without external server roundtrips."
  activeTab="converters"
  canonicalPath="/convert/xml-to-json"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        API Migration
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        XML TO JSON CONVERTER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Convert legacy XML schemas and API payloads into structured modern JSON. Parses tags, values, and attributes accurately in your browser.
      </p>
    </div>

    <ConverterApp client:load initialMode="xml-to-json" />
  </div>
</Layout>
