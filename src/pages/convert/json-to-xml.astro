---
import Layout from '../../layouts/Layout.astro';
import ConverterApp from '../../components/tools/ConverterApp';
---

<Layout
  title="JSON to XML Converter Online — Generate Valid XML Documents"
  description="Convert JSON data into clean XML documents. Preserves attributes, arrays, and nested structures for enterprise feeds."
  activeTab="converters"
  canonicalPath="/convert/json-to-xml"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        Legacy Integration
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        JSON TO XML CONVERTER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Transform JSON payloads into standard XML documents for SOAP endpoints, RSS/Atom feeds, and legacy enterprise architectures.
      </p>
    </div>

    <ConverterApp client:load initialMode="json-to-xml" />
  </div>
</Layout>
