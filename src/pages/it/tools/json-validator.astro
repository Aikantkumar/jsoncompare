---
import Layout from '../../../layouts/Layout.astro';
import JsonValidatorApp from '../../../components/tools/JsonValidatorApp';
---
<Layout lang="it" title="Validatore JSON online — Gratuito, privato e diagnosi sintassi istantanea" description="Valida la sintassi JSON online con diagnosi errori in tempo reale, numero di riga e colonna e riparazione automatica con 1 clic." activeTab="tools" canonicalPath="/tools/json-validator"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>Utilità per sviluppatore</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">Validatore JSON</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">Valida documenti JSON online con diagnosi errori di sintassi in tempo reale fino al numero esatto di riga e colonna. Riparazione automatica con 1 clic. Funziona al 100% localmente nel browser.</p></div><JsonValidatorApp client:load lang="it" /></div></Layout>
