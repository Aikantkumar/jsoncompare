---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://jsoncompareonline.com/it" }, { "@type": "ListItem", position: 2, name: "Contatti", item: "https://jsoncompareonline.com/it/contact" } ] };
const contactSchema = { "@context": "https://schema.org", "@type": "ContactPage", name: "Contatta JSON Compare Online", url: "https://jsoncompareonline.com/it/contact", description: "Contatta il team di JSON Compare Online per supporto tecnico, segnalazioni di bug, suggerimenti di funzionalità o richieste di compliance aziendale." };
---
<Layout lang="it" title="Contattaci — Supporto tecnico e feedback | JSON Compare Online" description="Contatta il team di JSON Compare Online per segnalazioni di bug, suggerimenti algoritmici, richieste di funzionalità o richieste di compliance aziendale." canonicalPath="/contact" activeTab="contact" structuredData={[breadcrumbSchema, contactSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Supporto sviluppatore</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">CONTATTACI</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Un bug borderline del parser AST, una richiesta di algoritmo o una richiesta di sicurezza e compliance? Saremo lieti di sentirti.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🐛</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Segnalazioni di bug e problemi</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Hai trovato un bug del parser AST o un caso limite di schema non gestito? Facci sapere con snippet di esempio riproducibili.</p><a href="mailto:bugs@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">bugs@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">💡</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Richieste di funzionalità</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Vuoi un nuovo formato di convertitore, opzioni di indentazione personalizzate o logica di filtraggio JSONPath specifica?</p><a href="mailto:features@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">features@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🛡️</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Sicurezza e privacy</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Per divulgazione di vulnerabilità, richieste di penetration test o audit di privacy aziendale:</p><a href="mailto:security@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">security@jsoncompareonline.com</a></div>
      </div>
      <div class="md:col-span-2">
        <div class="p-6 sm:p-8 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
          <h2 class="text-lg font-bold text-[#111111] dark:text-[#f0f0f2] mb-1">Invia un messaggio</h2>
          <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mb-6">Compila il modulo qui sotto. Il nostro team di sviluppatori risponde solitamente entro 24-48 ore.</p>
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label for="contact-name" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Il tuo nome *</label><input type="text" id="contact-name" name="name" required placeholder="es. Alex Chen" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
              <div><label for="contact-email" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Indirizzo email *</label><input type="email" id="contact-email" name="email" required placeholder="alex@azienda.com" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
            </div>
            <div><label for="contact-category" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Argomento / Categoria</label><select id="contact-category" name="category" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors"><option value="General Feedback">Feedback generale</option><option value="Bug Report">Segnalazione bug / Problema parser</option><option value="Feature Suggestion">Suggerimento funzionalità</option><option value="Security & Compliance">Sicurezza e compliance</option><option value="Partnership">Partnership / Richiesta API</option></select></div>
            <div><label for="contact-message" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Il tuo messaggio *</label><textarea id="contact-message" name="message" rows="5" required placeholder="Descrivi la tua domanda, idea di funzionalità o dettagli dell'errore..." class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors resize-y"></textarea></div>
            <div id="contact-status" class="hidden p-3 rounded-xl text-xs font-medium"></div>
            <button type="submit" id="contact-submit" class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors cursor-pointer">Invia messaggio</button>
          </form>
        </div>
      </div>
    </div>
    <script is:inline>(function(){const form=document.getElementById('contact-form');const statusBox=document.getElementById('contact-status');const submitBtn=document.getElementById('contact-submit');if(!form||!statusBox||!submitBtn)return;form.addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('contact-name').value.trim();const email=document.getElementById('contact-email').value.trim();const category=document.getElementById('contact-category').value;const message=document.getElementById('contact-message').value.trim();if(!name||!email||!message){statusBox.className='p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300 block';statusBox.textContent='Compila tutti i campi obbligatori.';return;}submitBtn.disabled=true;submitBtn.textContent='Invio in corso...';setTimeout(()=>{statusBox.className='p-3 rounded-xl text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 block';statusBox.innerHTML='<strong>Grazie!</strong> Il tuo messaggio è stato preparato. Se il client di posta non si apre automaticamente, puoi scrivere direttamente a <a href="mailto:support@jsoncompareonline.com" class="underline font-bold">support@jsoncompareonline.com</a>.';const subject=encodeURIComponent(`[${category}] Da ${name}`);const body=encodeURIComponent(`Nome: ${name}\nEmail: ${email}\nCategoria: ${category}\n\nMessaggio:\n${message}`);window.location.href=`mailto:support@jsoncompareonline.com?subject=${subject}&body=${body}`;form.reset();submitBtn.disabled=false;submitBtn.textContent='Invia messaggio';},600);});})();</script>
  </div>
</Layout>
