---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Home", item: "https://jsoncompareonline.com/it" }, { "@type": "ListItem", position: 2, name: "FAQ", item: "https://jsoncompareonline.com/it/faq" } ] };
const faqs = [
  { q: "come confrontare due file json", a: "Incolla i documenti di riferimento (Sinistra) e modificati (Destra) nei nostri editor di confronto JSON online, o clicca su \"Carica file\" per importare file .json dal tuo computer. Mantieni \"Ordina chiavi\" attivato per ignorare l'ordine delle chiavi, quindi esegui il diff. Le chiavi aggiunte appaiono in verde, le proprietà rimosse in rosso e i valori modificati in ambra. Passa tra le viste Affiancata e Unificata, ed esporta un patch RFC 6902 JSON con 1 clic di tutte le modifiche rilevate." },
  { q: "Cos'è la differenza JSON?", a: "La differenza JSON (JSON diff) è il processo di confrontare due documenti JSON per identificare esattamente cosa è cambiato tra di essi — chiavi aggiunte, chiavi rimosse, valori modificati, cambi di tipo e inserzioni o cancellazioni di array. Un diff semantico JSON analizza la struttura del documento invece di trattarlo come testo semplice, quindi chiavi riordinate, cambi di spazi bianchi e differenze di indentazione non generano falsi positivi." },
  { q: "A cosa serve al meglio JSON?", a: "JSON (JavaScript Object Notation) è ideale per lo scambio di dati leggero tra client web e server, payload di richiesta e risposta API REST, file di configurazione come package.json e tsconfig.json, archiviazione documenti NoSQL e stato dell'applicazione frontend. È indipendente dal linguaggio, leggibile dall'uomo e nativamente supportato da ogni linguaggio di programmazione moderno." }
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---
<Layout lang="it" title="Domande frequenti JSON Compare | JSON Compare Online" description="Domande frequenti sul nostro strumento di confronto JSON semantico, patch RFC 6902, sorter chiavi JSON, privacy lato client e convertitori JSON." keywords="json compare faq, json compare online, come confrontare file json, differenza json, strumento confronto json, patch json rfc 6902, sorter chiavi json, json a typescript, convertitore json, confronto json lato client" canonicalPath="/faq" activeTab="faq" structuredData={[breadcrumbSchema, faqSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Centro assistenza</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">DOMANDE FREQUENTI</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Tutto quello che devi sapere sui nostri algoritmi di diff semantico, strumenti per sviluppatori, architettura di sicurezza e convertitori di dati.</p>
    </div>
    <section class="space-y-4">{faqs.map((faq) => (<details class="group bg-white dark:bg-[#14161b] rounded-2xl border border-[#e5e5e5] dark:border-[#22242a] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer"><summary class="flex items-center justify-between font-semibold text-sm text-[#111111] dark:text-[#f0f0f2]"><span>{faq.q}</span><span class="ml-4 text-[#707072] dark:text-[#8e8e93] group-open:rotate-180 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span></summary><p class="mt-3 text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed border-t border-[#f5f5f5] dark:border-[#202228] pt-3">{faq.a}</p></details>))}</section>
    <section class="mt-12 p-6 sm:p-8 rounded-2xl border border-[#111111] dark:border-[#f0f0f2] flex flex-col sm:flex-row items-center justify-between gap-4"><div><h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2]">Pronto a confrontare JSON?</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-0.5">Inizia a fare diff di due payload JSON istantaneamente — 100% lato client, senza upload.</p></div><a href="/it/" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors shrink-0">Apri strumento confronto JSON</a></section>
  </div>
</Layout>
