---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "首页", item: "https://jsoncompareonline.com/zh" }, { "@type": "ListItem", position: 2, name: "联系我们", item: "https://jsoncompareonline.com/zh/contact" } ] };
const contactSchema = { "@context": "https://schema.org", "@type": "ContactPage", name: "联系 JSON Compare Online", url: "https://jsoncompareonline.com/zh/contact", description: "与 JSON Compare Online 团队联系，获取技术支持、错误报告、功能建议或企业合规性查询。" };
---

<Layout lang="zh" title="联系我们 — 技术支持与反馈 | JSON Compare Online" description="联系 JSON Compare Online 团队，获取错误报告、算法建议、功能请求或企业合规性查询。" canonicalPath="/contact" activeTab="contact" structuredData={[breadcrumbSchema, contactSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>开发者支持</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">联系我们</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">遇到 AST 解析器边缘错误、算法请求或安全合规性查询？我们很乐意听取您的意见。</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🐛</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">错误报告与问题</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">发现 AST 解析器错误或未处理的架构边缘情况？请提供可重现的示例代码片段。</p><a href="mailto:bugs@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">bugs@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">💡</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">功能请求</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">想要新的转换器格式、自定义缩进选项或特定的 JSONPath 过滤逻辑？</p><a href="mailto:features@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">features@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🛡️</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">安全与隐私</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">关于漏洞披露、渗透测试咨询或企业隐私审计：</p><a href="mailto:security@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">security@jsoncompareonline.com</a></div>
      </div>
      <div class="md:col-span-2">
        <div class="p-6 sm:p-8 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
          <h2 class="text-lg font-bold text-[#111111] dark:text-[#f0f0f2] mb-1">给我们发消息</h2>
          <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mb-6">填写下面的表格。我们的开发者团队通常在 24 至 48 小时内回复。</p>
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label for="contact-name" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">您的姓名 *</label><input type="text" id="contact-name" name="name" required placeholder="例如 Alex Chen" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
              <div><label for="contact-email" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">电子邮件 *</label><input type="email" id="contact-email" name="email" required placeholder="alex@company.com" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
            </div>
            <div><label for="contact-category" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">主题 / 类别</label><select id="contact-category" name="category" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors"><option value="General Feedback">一般反馈</option><option value="Bug Report">错误报告 / 解析器问题</option><option value="Feature Suggestion">功能建议</option><option value="Security & Compliance">安全与合规</option><option value="Partnership">合作伙伴 / API 查询</option></select></div>
            <div><label for="contact-message" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">您的消息 *</label><textarea id="contact-message" name="message" rows="5" required placeholder="描述您的问题、功能构想或错误详细信息..." class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors resize-y"></textarea></div>
            <div id="contact-status" class="hidden p-3 rounded-xl text-xs font-medium"></div>
            <button type="submit" id="contact-submit" class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors cursor-pointer">发送消息</button>
          </form>
        </div>
      </div>
    </div>
    <script is:inline>(function(){const form=document.getElementById('contact-form');const statusBox=document.getElementById('contact-status');const submitBtn=document.getElementById('contact-submit');if(!form||!statusBox||!submitBtn)return;form.addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('contact-name').value.trim();const email=document.getElementById('contact-email').value.trim();const category=document.getElementById('contact-category').value;const message=document.getElementById('contact-message').value.trim();if(!name||!email||!message){statusBox.className='p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300 block';statusBox.textContent='请填写所有必填字段。';return;}submitBtn.disabled=true;submitBtn.textContent='发送中...';setTimeout(()=>{statusBox.className='p-3 rounded-xl text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 block';statusBox.innerHTML='<strong>谢谢！</strong> 您的消息已准备就绪。如果您的邮件客户端未自动打开，您可以直接发送邮件至 <a href="mailto:support@jsoncompareonline.com" class="underline font-bold">support@jsoncompareonline.com</a>。';const subject=encodeURIComponent(`[${category}] 来自 ${name}`);const body=encodeURIComponent(`姓名: ${name}\n电子邮件: ${email}\n类别: ${category}\n\n消息:\n${message}`);window.location.href=`mailto:support@jsoncompareonline.com?subject=${subject}&body=${body}`;form.reset();submitBtn.disabled=false;submitBtn.textContent='发送消息';},600);});})();</script>
  </div>
</Layout>
