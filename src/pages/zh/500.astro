---
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="zh" title="500 — 内部错误 | JSON Compare Online" description="执行开发者应用程序时发生意外错误。探索恢复说明和系统重置选项。" canonicalPath="/500">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-950/40 text-[11px] font-mono text-amber-800 dark:text-amber-400 mb-6 border border-amber-200 dark:border-amber-900/60"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>HTTP 500 • 执行异常</div>
    <h1 class="text-6xl sm:text-7xl font-black tracking-tight text-[#111111] dark:text-[#f0f0f2] font-mono mb-4">500</h1>
    <h2 class="text-xl sm:text-2xl font-bold text-[#111111] dark:text-[#f0f0f2] mb-3">意外执行异常</h2>
    <p class="text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-md mx-auto leading-relaxed mb-8">处理过程中发生意外错误。由于 JSON Compare Online 在浏览器中运行，如果特大负载超过了浏览器堆内存或遇到未处理的语法循环，可能会发生这种情况。</p>
    <div class="flex flex-wrap items-center justify-center gap-4"><button id="reload-btn" class="px-6 py-2.5 rounded-full text-xs font-bold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors cursor-pointer">重新加载页面</button><button id="reset-storage-btn" class="px-6 py-2.5 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#e5e5e5] dark:hover:bg-[#252830] transition-colors cursor-pointer">重置本地会话</button><a href="/zh/" class="px-6 py-2.5 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#e5e5e5] dark:hover:bg-[#252830] transition-colors">返回主页</a></div>
    <script is:inline>document.getElementById('reload-btn')?.addEventListener('click',()=>{window.location.reload();});document.getElementById('reset-storage-btn')?.addEventListener('click',()=>{try{localStorage.clear();sessionStorage.clear();alert('本地会话已重置。正在返回主页。');window.location.href='/zh/';}catch(e){window.location.href='/zh/';}});</script>
  </div>
</Layout>
