import Layout from '../../../layouts/Layout.astro';
import JsonSorterApp from '../../../components/tools/JsonSorterApp';
---
<Layout lang="zh" title="在线 JSON 键排序器 — 免费深度字母顺序" description="通过对键进行深度升序或降序字母排序来标准化杂乱的负载结构。" activeTab="tools" canonicalPath="/tools/json-sorter"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>开发者实用工具</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">JSON 键排序器</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">使用我们独立的 JSON 键排序器标准化杂乱的负载结构。它以升序或降序字母顺序深度排序键，使版本比较和代码审查变得清晰轻松。</p></div><JsonSorterApp client:load /></div></Layout>
