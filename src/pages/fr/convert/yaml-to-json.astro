import Layout from '../../../layouts/Layout.astro';
import ConverterApp from '../../../components/tools/ConverterApp';
---
<Layout lang="fr" title="Convertisseur YAML vers JSON en ligne — Parseur imbriqué rapide et validateur" description="Convertissez des chaînes et fichiers YAML en JSON structuré en ligne avec validation de syntaxe, gestion d'indentation et copie instantanée dans le presse-papiers." activeTab="converters" canonicalPath="/convert/yaml-to-json"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>DevOps et configuration</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">Convertisseur YAML vers JSON</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">Transformez les configurations YAML, graphiques Helm et pipelines CI/CD en payloads JSON valides sans envoyer de données sur le réseau.</p></div><ConverterApp client:load initialMode="yaml-to-json" /></div></Layout>
