---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Accueil", item: "https://jsoncompareonline.com/fr" }, { "@type": "ListItem", position: 2, name: "FAQ", item: "https://jsoncompareonline.com/fr/faq" } ] };
const faqs = [
  { q: "comment comparer deux fichiers json", a: "Collez vos documents de référence (Gauche) et modifiés (Droite) dans nos éditeurs de comparaison JSON en ligne, ou cliquez sur \"Charger un fichier\" pour importer des fichiers .json depuis votre ordinateur. Maintenez \"Trier les clés\" activé pour ignorer l'ordre des clés, puis exécutez le diff. Les clés ajoutées apparaissent en vert, les propriétés supprimées en rouge, et les valeurs modifiées en ambre. Passez entre les vues Côte-à-Côte et Unifiée, et exportez un correctif RFC 6902 JSON en 1 clic de tous les changements détectés." },
  { q: "Qu'est-ce qu'une différence JSON ?", a: "La différence JSON (JSON diff) est le processus de comparaison de deux documents JSON pour identifier exactement ce qui a changé entre eux — clés ajoutées, clés supprimées, valeurs modifiées, changements de type, et insertions ou suppressions de tableaux. Un diff sémantique JSON analyse la structure du document plutôt que de le traiter comme du texte brut, donc les clés réordonnées, les changements d'espacement et les différences d'indentation ne déclenchent pas de faux positifs." },
  { q: "À quoi sert le mieux JSON ?", a: "JSON (JavaScript Object Notation) est idéal pour l'échange de données léger entre clients web et serveurs, les payloads de requête et réponse d'API REST, les fichiers de configuration comme package.json et tsconfig.json, le stockage de documents NoSQL, et l'état des applications frontend. Il est indépendant du langage, lisible par l'homme, et nativement supporté par chaque langage de programmation moderne." }
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---
<Layout lang="fr" title="FAQ JSON Compare | JSON Compare Online" description="Questions fréquentes sur notre outil de comparaison JSON sémantique, correctifs RFC 6902, tri de clés JSON, confidentialité côté client et convertisseurs JSON." keywords="json compare faq, json compare en ligne, comment comparer des fichiers json, difference json, outil json compare, correctif json rfc 6902, tri de clés json, json vers typescript, convertisseur json, comparaison json côté client" canonicalPath="/faq" activeTab="faq" structuredData={[breadcrumbSchema, faqSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Centre d'aide</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">QUESTIONS FRÉQUENTES</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Tout ce que vous devez savoir sur nos algorithmes de diff sémantique, outils de développeur, architecture de sécurité et convertisseurs de données.</p>
    </div>
    <section class="space-y-4">{faqs.map((faq) => (<details class="group bg-white dark:bg-[#14161b] rounded-2xl border border-[#e5e5e5] dark:border-[#22242a] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer"><summary class="flex items-center justify-between font-semibold text-sm text-[#111111] dark:text-[#f0f0f2]"><span>{faq.q}</span><span class="ml-4 text-[#707072] dark:text-[#8e8e93] group-open:rotate-180 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span></summary><p class="mt-3 text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed border-t border-[#f5f5f5] dark:border-[#202228] pt-3">{faq.a}</p></details>))}</section>
    <section class="mt-12 p-6 sm:p-8 rounded-2xl border border-[#111111] dark:border-[#f0f0f2] flex flex-col sm:flex-row items-center justify-between gap-4"><div><h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2]">Prêt à comparer du JSON ?</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-0.5">Commencez à différencier deux payloads JSON instantanément — 100 % côté client, sans upload.</p></div><a href="/fr/" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors shrink-0">Ouvrir l'outil de comparaison JSON</a></section>
  </div>
</Layout>
