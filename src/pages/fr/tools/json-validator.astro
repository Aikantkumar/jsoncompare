import Layout from '../../../layouts/Layout.astro';
import JsonValidatorApp from '../../../components/tools/JsonValidatorApp';
---
<Layout lang="fr" title="Validateur JSON en ligne — Gratuit, privé et diagnostic syntaxique instantané" description="Validez la syntaxe JSON en ligne avec diagnostic d'erreurs en temps réel, numéro de ligne et de colonne, et réparation automatique en 1 clic." activeTab="tools" canonicalPath="/tools/json-validator"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>Outil développeur</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">Validateur JSON</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">Validez des documents JSON en ligne avec diagnostic des erreurs de syntaxe en temps réel jusqu'au numéro exact de ligne et de colonne. Réparation automatique en 1 clic. Fonctionne à 100 % localement dans votre navigateur.</p></div><JsonValidatorApp client:load lang="fr" /></div></Layout>
