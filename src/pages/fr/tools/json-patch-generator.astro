---
import Layout from '../../../layouts/Layout.astro';
import JsonPatchGeneratorApp from '../../../components/tools/JsonPatchGeneratorApp';
---
<Layout lang="fr" title="Générateur de correctifs RFC 6902 JSON en ligne — Correctifs opérationnels gratuits" description="Générez des correctifs opérationnels standards RFC 6902 (add, remove, replace, move) à partir de deux objets JSON en 1 clic." activeTab="tools" canonicalPath="/tools/json-patch-generator"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>Outil développeur</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">Générateur de correctifs RFC 6902 JSON</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">Générez des correctifs opérationnels standards RFC 6902 (add, remove, replace, move, copy, test) à partir de deux objets JSON en 1 clic. Fonctionne à 100 % localement dans votre navigateur.</p></div><JsonPatchGeneratorApp client:load lang="fr" /></div></Layout>
