---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Accueil", item: "https://jsoncompareonline.com/fr" }, { "@type": "ListItem", position: 2, name: "Contact", item: "https://jsoncompareonline.com/fr/contact" } ] };
const contactSchema = { "@context": "https://schema.org", "@type": "ContactPage", name: "Contacter JSON Compare Online", url: "https://jsoncompareonline.com/fr/contact", description: "Contactez l'équipe de JSON Compare Online pour le support technique, les rapports de bugs, les suggestions de fonctionnalités ou les requêtes de conformité d'entreprise." };
---
<Layout lang="fr" title="Contactez-nous — Support technique et commentaires | JSON Compare Online" description="Contactez l'équipe de JSON Compare Online pour les rapports de bugs, suggestions d'algorithmes, demandes de fonctionnalités ou requêtes de conformité d'entreprise." canonicalPath="/contact" activeTab="contact" structuredData={[breadcrumbSchema, contactSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Support développeur</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">CONTACTEZ-NOUS</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Un bug de bord dans le parseur AST, une demande d'algorithme ou une requête de conformité de sécurité ? Nous serions ravis d'avoir de vos nouvelles.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="space-y-4">
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🐛</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Rapports de bugs et problèmes</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Vous avez trouvé un bug de parseur AST ou un cas limite de schéma non traité ? Faites-le nous savoir avec des extraits d'exemple reproductibles.</p><a href="mailto:bugs@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">bugs@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">💡</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Demandes de fonctionnalités</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Vous voulez un nouveau format de convertisseur, des options d'indentation personnalisées ou une logique de filtrage JSONPath spécifique ?</p><a href="mailto:features@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">features@jsoncompareonline.com</a></div>
        <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]"><div class="w-8 h-8 rounded-lg bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] flex items-center justify-center text-sm mb-3">🛡️</div><h2 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">Sécurité et confidentialité</h2><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-1 leading-relaxed">Pour la divulgation de vulnérabilités, les demandes de test de pénétration ou les audits de confidentialité d'entreprise :</p><a href="mailto:security@jsoncompareonline.com" class="text-xs font-mono font-medium underline text-[#111111] dark:text-[#f0f0f2] mt-3 block">security@jsoncompareonline.com</a></div>
      </div>
      <div class="md:col-span-2">
        <div class="p-6 sm:p-8 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
          <h2 class="text-lg font-bold text-[#111111] dark:text-[#f0f0f2] mb-1">Envoyez-nous un message</h2>
          <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mb-6">Remplissez le formulaire ci-dessous. Notre équipe de développeurs répond généralement sous 24 à 48 heures.</p>
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div><label for="contact-name" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Votre nom *</label><input type="text" id="contact-name" name="name" required placeholder="ex. Alex Chen" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
              <div><label for="contact-email" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Adresse e-mail *</label><input type="email" id="contact-email" name="email" required placeholder="alex@entreprise.com" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors" /></div>
            </div>
            <div><label for="contact-category" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Sujet / Catégorie</label><select id="contact-category" name="category" class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors"><option value="General Feedback">Commentaires généraux</option><option value="Bug Report">Rapport de bug / Problème de parseur</option><option value="Feature Suggestion">Suggestion de fonctionnalité</option><option value="Security & Compliance">Sécurité et conformité</option><option value="Partnership">Partenariat / Requête API</option></select></div>
            <div><label for="contact-message" class="block text-xs font-medium text-[#111111] dark:text-[#f0f0f2] mb-1">Votre message *</label><textarea id="contact-message" name="message" rows="5" required placeholder="Décrivez votre question, idée de fonctionnalité ou détails de l'erreur..." class="w-full px-3 py-2 rounded-xl text-xs bg-white dark:bg-[#1a1c23] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] focus:outline-none focus:ring-2 focus:ring-[#111111] dark:focus:ring-[#f0f0f2] transition-colors resize-y"></textarea></div>
            <div id="contact-status" class="hidden p-3 rounded-xl text-xs font-medium"></div>
            <button type="submit" id="contact-submit" class="w-full py-2.5 rounded-xl text-xs font-bold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors cursor-pointer">Envoyer le message</button>
          </form>
        </div>
      </div>
    </div>
    <script is:inline>(function(){const form=document.getElementById('contact-form');const statusBox=document.getElementById('contact-status');const submitBtn=document.getElementById('contact-submit');if(!form||!statusBox||!submitBtn)return;form.addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('contact-name').value.trim();const email=document.getElementById('contact-email').value.trim();const category=document.getElementById('contact-category').value;const message=document.getElementById('contact-message').value.trim();if(!name||!email||!message){statusBox.className='p-3 rounded-xl text-xs font-medium bg-red-100 text-red-800 dark:bg-red-950/40 dark:text-red-300 block';statusBox.textContent='Veuillez remplir tous les champs obligatoires.';return;}submitBtn.disabled=true;submitBtn.textContent="Envoi...";setTimeout(()=>{statusBox.className='p-3 rounded-xl text-xs font-medium bg-emerald-100 text-emerald-800 dark:bg-emerald-950/40 dark:text-emerald-300 block';statusBox.innerHTML='<strong>Merci !</strong> Votre message a été préparé. Si votre client de messagerie ne s\'ouvre pas automatiquement, vous pouvez nous écrire directement à <a href="mailto:support@jsoncompareonline.com" class="underline font-bold">support@jsoncompareonline.com</a>.';const subject=encodeURIComponent(`[${category}] De ${name}`);const body=encodeURIComponent(`Nom: ${name}\nE-mail: ${email}\nCatégorie: ${category}\n\nMessage:\n${message}`);window.location.href=`mailto:support@jsoncompareonline.com?subject=${subject}&body=${body}`;form.reset();submitBtn.disabled=false;submitBtn.textContent='Envoyer le message';},600);});})();</script>
  </div>
</Layout>
