              </tr>
            </thead>
            <tbody class="divide-y divide-[#e5e5e5] dark:divide-[#22242a] text-[#4b4b4d] dark:text-[#9ca3af]">
              <tr>
                <td class="p-3 font-medium text-[#111111] dark:text-[#f0f0f2]">Key Ordering Sensitivity</td>
                <td class="p-3 text-red-600 dark:text-red-400">Flags reordered keys as mutations</td>
                <td class="p-3 text-[#007d48] dark:text-[#34d399] font-medium">Order-agnostic via semantic AST sorting</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-[#111111] dark:text-[#f0f0f2]">Whitespace & Tabs</td>
                <td class="p-3 text-red-600 dark:text-red-400">Reports false discrepancies for spacing</td>
                <td class="p-3 text-[#007d48] dark:text-[#34d399] font-medium">Completely ignored; focuses on pure data</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-[#111111] dark:text-[#f0f0f2]">Array Element Matching</td>
                <td class="p-3 text-red-600 dark:text-red-400">Index shift causes cascade errors</td>
                <td class="p-3 text-[#007d48] dark:text-[#34d399] font-medium">Smart array alignment by unique identifier</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-[#111111] dark:text-[#f0f0f2]">RFC 6902 Patch Output</td>
                <td class="p-3">Unsupported (Unified text patch only)</td>
                <td class="p-3 text-[#007d48] dark:text-[#34d399] font-medium">Native 1-click JSON Patch export</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-[#111111] dark:text-[#f0f0f2]">Privacy & Security</td>
                <td class="p-3">Often sends payloads to remote servers</td>
                <td class="p-3 text-[#007d48] dark:text-[#34d399] font-medium">100% In-browser execution with zero tracking</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </article>

