---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Início", item: "https://jsoncompareonline.com/pt" }, { "@type": "ListItem", position: 2, name: "Perguntas frequentes", item: "https://jsoncompareonline.com/pt/faq" } ] };
const faqs = [
  { q: "como comparar dois arquivos json", a: "Cole seus documentos de linha de base (Esquerda) e modificados (Direita) em nossos editores de comparação JSON online, ou clique em \"Carregar arquivo\" para importar arquivos .json do seu computador. Mantenha \"Ordenar chaves\" ativado para ignorar a ordem das chaves, então execute o diff. Chaves adicionadas aparecem em verde, propriedades removidas em vermelho e valores modificados em âmbar. Alterne entre as visualizações Lado a Lado e Unificada, e exporte um patch RFC 6902 JSON com 1 clique de todas as mudanças detectadas." },
  { q: "O que é diferença JSON?", a: "Diferença JSON (JSON diff) é o processo de comparar dois documentos JSON para identificar exatamente o que mudou entre eles — chaves adicionadas, chaves removidas, valores modificados, mudanças de tipo e inserções ou exclusões de array. Um diff semântico JSON analisa a estrutura do documento em vez de tratá-lo como texto simples, portanto chaves reordenadas, mudanças de espaços em branco e diferenças de indentação não disparam falsos positivos." },
  { q: "Para que o JSON é mais adequado?", a: "JSON (JavaScript Object Notation) é mais adequado para intercâmbio de dados leve entre clientes web e servidores, payloads de requisição e resposta de APIs REST, arquivos de configuração como package.json e tsconfig.json, armazenamento de documentos NoSQL e estado de aplicações frontend. É independente de linguagem, legível por humanos e nativamente suportado por todas as linguagens de programação modernas." }
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---
<Layout lang="pt" title="Perguntas Frequentes JSON Compare | JSON Compare Online" description="Perguntas frequentes sobre nossa ferramenta de comparação JSON semântica, patches RFC 6902, sorter de chaves JSON, privacidade do lado do cliente e conversores JSON." keywords="json compare faq, json compare online, como comparar arquivos json, diferença json, ferramenta comparação json, patch json rfc 6902, sorter de chaves json, json para typescript, conversor json, comparação json lado do cliente" canonicalPath="/faq" activeTab="faq" structuredData={[breadcrumbSchema, faqSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Central de ajuda</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">PERGUNTAS FREQUENTES</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Tudo o que você precisa saber sobre nossos algoritmos de diff semântico, ferramentas para desenvolvedores, arquitetura de segurança e conversores de dados.</p>
    </div>
    <section class="space-y-4">{faqs.map((faq) => (<details class="group bg-white dark:bg-[#14161b] rounded-2xl border border-[#e5e5e5] dark:border-[#22242a] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer"><summary class="flex items-center justify-between font-semibold text-sm text-[#111111] dark:text-[#f0f0f2]"><span>{faq.q}</span><span class="ml-4 text-[#707072] dark:text-[#8e8e93] group-open:rotate-180 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span></summary><p class="mt-3 text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed border-t border-[#f5f5f5] dark:border-[#202228] pt-3">{faq.a}</p></details>))}</section>
    <section class="mt-12 p-6 sm:p-8 rounded-2xl border border-[#111111] dark:border-[#f0f0f2] flex flex-col sm:flex-row items-center justify-between gap-4"><div><h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2]">Pronto para comparar JSON?</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-0.5">Comece a diff de dois payloads JSON instantaneamente — 100% lado do cliente, sem uploads.</p></div><a href="/pt/" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors shrink-0">Abrir ferramenta de comparação JSON</a></section>
  </div>
</Layout>
