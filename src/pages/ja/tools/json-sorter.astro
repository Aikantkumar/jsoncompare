import Layout from '../../../layouts/Layout.astro';
import JsonSorterApp from '../../../components/tools/JsonSorterApp';
---
<Layout lang="ja" title="オンライン JSON キーソーター — 無料の深いアルファベット順" description="キーを深く昇順または降順アルファベット順にソートして、乱雑なペイロード構造を標準化。" activeTab="tools" canonicalPath="/tools/json-sorter"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10"><div class="mb-8"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>開発者ユーティリティ</div><h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">JSON キーソーター</h1><p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">独立した JSON キーソーターを使用して乱雑なペイロード構造を標準化。キーを昇順または降順アルファベット順に深くソートし、バージョン比較とコードレビューをクリーンかつ簡単に。</p></div><JsonSorterApp client:load /></div></Layout>
