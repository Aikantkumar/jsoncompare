---
import Layout from '../../layouts/Layout.astro';
import JsonCompareApp from '../../components/diff/JsonCompareApp';
const features = [
  { title: "セマンティックでキー順序に依存しない", desc: "オブジェクトキーの順序と空白を自動正規化。見た目のインデントではなく意味とデータの変更を比較します。", badge: "セマンティック" },
  { title: "一意 ID による配列整合", desc: "識別子（`id`、`uuid`、`key`）で配列要素を整合し、挿入行がシーケンス全体をずらしたり壊したりしないようにします。", badge: "スマートマッチ" },
  { title: "RFC 6902 JSON パッチ", desc: "標準操作パッチ（add, remove, replace, move）を 1 クリックでエクスポートし、データベースや API モックを同期します。", badge: "RFC 6902" },
  { title: "1 クリック スマート構文修復", desc: "末尾カンマ、単一引用符、引用符なしキー、Python `True/False/None` を比較前に即座に自動修復します。", badge: "自動修復" },
  { title: "JSONPath サブクエリ差分", desc: "比較前に大規模な 100k 行レスポンスをターゲットノード（`$.items[*].sku`）に絞り込みます。", badge: "JSONPath" },
  { title: "100% クライアント側プライバシー", desc: "すべての計算はブラウザ内で実行されます。トークン、認証情報、顧客データがリモートサーバーに送信されることはありません。", badge: "プライベート" }
];
---
<Layout lang="ja" title="JSON Compare Online — 高速、セマンティック、プライベートな JSON オンライン比較ツール" description="2 つの JSON オブジェクトまたはファイルをオンラインで比較。セマンティック差分、キー順序独立、RFC 6902 パッチ生成、ゼロサーバーアップロードプライバシー。" keywords="json オンライン比較, json 比較ツール, json 差分, json フォーマッタ, json バリダター, json ミニファイア, json パッチ, json タイプスクリプト, json キーソーター, yaml から json, json から yaml, xml から json, json から xml, csv から json, json から csv" activeTab="compare" canonicalPath="/">
  <section class="border-b border-[#e5e5e5] dark:border-[#22242a] bg-white dark:bg-[#000000] pt-8 pb-6 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#1eaa52]"></span>セマンティック JSON 差分エンジン • 100% クライアント側プライバシー</div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase leading-none">オンライン セマンティック JSON 比較</h1>
          <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl leading-relaxed">現代的な <strong>json 比較ツール</strong> とセマンティック差分分析器。2 つの JSON ペイロードを並べ替えまたは統一表示で比較し、キーを正規化し、ID で配列を整合し、データを外部サーバーにアップロードすることなく RFC 6902 パッチをエクスポートします。</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap"><a href="/ja/tools/json-formatter" class="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#111111] hover:text-white dark:hover:bg-[#f0f0f2] dark:hover:text-[#111111] transition-colors">JSON フォーマッタ</a><a href="/ja/tools/json-validator" class="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#111111] hover:text-white dark:hover:bg-[#f0f0f2] dark:hover:text-[#111111] transition-colors">JSON バリダター</a><a href="/ja/tools/json-to-typescript" class="px-4 py-2 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors">JSON から TypeScript</a></div>
      </div>
    </div>
  </section>
  <section class="bg-white dark:bg-[#000000] transition-colors"><JsonCompareApp client:load /></section>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10 text-center max-w-2xl mx-auto"><span class="text-xs font-mono uppercase tracking-widest text-[#707072] dark:text-[#8e8e93]">モダン開発者向け設計</span><h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#111111] dark:text-[#f0f0f2] mt-1">汎用差分ツールを凌駕する設計</h2><p class="text-sm text-[#4b4b4d] dark:text-[#9ca3af] mt-2">設定ファイルを比較し、マイクロサービスのレスポンスをデバッグし、RFC 準拠パッチを誤検出なしで生成します。</p></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">{features.map((feat) => (<div class="p-6 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#cacacb] dark:hover:border-[#383d47] transition-all flex flex-col justify-between"><div><div class="flex items-center justify-between mb-3"><span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] font-medium">{feat.badge}</span></div><h3 class="text-base font-bold text-[#111111] dark:text-[#f0f0f2] tracking-tight mb-2">{feat.title}</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed">{feat.desc}</p></div></div>))}</div>
  </section>
  <section class="bg-[#f5f5f5] dark:bg-[#111215] border-y border-[#e5e5e5] dark:border-[#22242a] py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8"><div><h2 class="text-xl font-bold tracking-tight text-[#111111] dark:text-[#f0f0f2]">包括的なデータ変換スイート</h2><p class="text-xs text-[#707072] dark:text-[#8e8e93] mt-0.5">ブラウザタブを離れることなく開発者ツールを切り替えます。</p></div></div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3"><a href="/ja/tools/json-formatter" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">JSON フォーマッタ</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">インデントと美化</span></a><a href="/ja/tools/json-validator" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">JSON バリダター</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">行診断</span></a><a href="/ja/tools/json-minifier" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">JSON ミニファイア</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">空白削除</span></a><a href="/ja/tools/json-patch-generator" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">RFC 6902 パッチ</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">操作型差分</span></a><a href="/ja/tools/json-to-typescript" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">JSON から TS</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">タイプ生成器</span></a><a href="/ja/convert/yaml-to-json" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group"><span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">YAML ⇄ JSON</span><span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">設定コンバータ</span></a></div>
    </div>
  </section>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-[#39393b] dark:text-[#d1d5db]">
    <div class="space-y-12">
      <header class="space-y-4"><div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-xs font-mono text-[#39393b] dark:text-[#b5b5b8] border border-[#e5e5e5] dark:border-[#22242a]">開発者向け完全ガイド</div><h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2]">JSON Compare の理解：なぜセマンティック差分がプレーンテキストツールを上回るのか</h2><p class="text-sm sm:text-base leading-relaxed">ソフトウェアエンジニアリング、分散アーキテクチャ、API 開発では、構造化データの比較は日常業務です。しかし、Git diff や Unix diff などの従来ツールに依存すると、開発者は頻繁にイライラする誤検出に直面します。標準テキスト差分はドキュメントを文字のシーケンスとして扱います。REST エンドポイントが同じ値だがキーの順序が異なるオブジェクトを返した場合、またはタブではなくスペースを使用した場合、テキスト比較はすべての行を変更とフラグします。ここで専用の <strong>json 比較</strong> エンジンと <strong>オンライン json 比較</strong> ツールが不可欠になります。</p><p class="text-sm sm:text-base leading-relaxed">当社のオンライン <strong>json 比較ツール</strong> はセマンティックツリー比較を実装します。文字位置を検査する代わりに、差分エンジンは両方の入力を抽象構文木（AST）にパースし、構造ノードを調整し、深い <strong>json 差分</strong> を実行します。マイクロサービス契約の不一致をデバッグしたり、ステージングと本番のデータベースダンプを検証したり、フロントエンド Redux ストアの状態変更を追跡したりする場合、セマンティック差分は実際の追加、削除、値変更を露呈し、任意の空白、インデントの違い、キー順序を無視します。</p></header>
    </div>
  </article>
</Layout>
