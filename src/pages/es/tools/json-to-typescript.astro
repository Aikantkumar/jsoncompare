---
import Layout from '../../../layouts/Layout.astro';
import JsonToTypeScriptApp from '../../../components/tools/JsonToTypeScriptApp';
---

<Layout
  lang="es"
  title="JSON a TypeScript online — Generador de tipos gratuito, privado e instantáneo"
  description="Genera interfaces de TypeScript, alias de tipos y tipos anidados opcionales a partir de cualquier carga JSON de muestra con 1 clic."
  activeTab="tools"
  canonicalPath="/tools/json-to-typescript"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        Utilidad para desarrolladores
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        JSON A TYPESCRIPT
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Elimina la creación de plantillas de interfaces de TypeScript. Pega cualquier carga JSON de muestra en nuestro generador JSON a TypeScript para sintetizar al instante interfaces de TypeScript con tipado fuerte, alias de tipos y tipos anidados opcionales con correcta nulabilidad de campos.
      </p>
    </div>

    <JsonToTypeScriptApp client:load lang="es" />
  </div>
</Layout>
