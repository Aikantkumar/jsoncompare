---
import Layout from '../../../layouts/Layout.astro';
import JsonPatchGeneratorApp from '../../../components/tools/JsonPatchGeneratorApp';
---

<Layout
  lang="es"
  title="Generador de parches RFC 6902 JSON online — Parches operativos gratuitos"
  description="Genera parches operativos RFC 6902 estándar (add, remove, replace, move) a partir de dos objetos JSON con 1 clic."
  activeTab="tools"
  canonicalPath="/tools/json-patch-generator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        Utilidad para desarrolladores
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        GENERADOR DE PARCHES RFC 6902 JSON
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Genera parches operativos RFC 6902 estándar (add, remove, replace, move, copy, test) a partir de dos objetos JSON con 1 clic. Ejecuta al 100% localmente en tu navegador.
      </p>
    </div>

    <JsonPatchGeneratorApp client:load lang="es" />
  </div>
</Layout>
