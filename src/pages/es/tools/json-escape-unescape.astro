---
import Layout from '../../../layouts/Layout.astro';
import JsonEscapeUnescapeApp from '../../../components/tools/JsonEscapeUnescapeApp';
---

<Layout
  lang="es"
  title="Escape y unescape JSON online — Conversor gratuito de cadenas stringificadas"
  description="Escapa JSON sin procesar para incrustarlo en cadenas o desescapa JSON stringificado a sintaxis limpia y legible con 1 clic."
  activeTab="tools"
  canonicalPath="/tools/json-escape-unescape"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        Utilidad para desarrolladores
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        ESCAPE Y UNESCAPE JSON
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        ¿Cansado de barras invertidas doblemente escapadas, comillas y caracteres de nueva línea en columnas de cadena de base de datos? Usa nuestro conversor de escape/unescape para desescapa JSON stringificado a sintaxis limpia y legible o escapa JSON sin procesar para incrustarlo dentro de cadenas. Ejecuta al 100% localmente en tu navegador.
      </p>
    </div>

    <JsonEscapeUnescapeApp client:load />
  </div>
</Layout>
