---
import Layout from '../../../layouts/Layout.astro';
import ConverterApp from '../../../components/tools/ConverterApp';
---

<Layout
  lang="es"
  title="Conversor CSV a JSON online — Parser anidado rápido y validador"
  description="Convierte datos de hojas de cálculo y exportaciones analíticas a objetos de array o aplanar objetos a filas tabulares online con copia instantánea al portapapeles."
  activeTab="converters"
  canonicalPath="/convert/csv-to-json"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        DevOps y configuración
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        CONVERSOR CSV A JSON
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Transforma datos de hojas de cálculo y exportaciones analíticas en objetos de array o aplana objetos a filas tabulares sin enviar datos a través de la red.
      </p>
    </div>

    <ConverterApp client:load initialMode="csv-to-json" />
  </div>
</Layout>
