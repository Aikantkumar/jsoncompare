---
import Layout from '../../../layouts/Layout.astro';
import ConverterApp from '../../../components/tools/ConverterApp';
---

<Layout
  lang="es"
  title="Conversor JSON a XML online — Parser anidado rápido y validador"
  description="Convierte cargas JSON a XML estructurado online con validación de sintaxis, manejo de espacios de nombres y copia instantánea al portapapeles."
  activeTab="converters"
  canonicalPath="/convert/json-to-xml"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        DevOps y configuración
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        CONVERSOR JSON A XML
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Transforma cargas JSON en XML estructurado para integración con sistemas empresariales heredados y fuentes RSS sin enviar datos a través de la red.
      </p>
    </div>

    <ConverterApp client:load lang="es" initialMode="json-to-xml" />
  </div>
</Layout>
