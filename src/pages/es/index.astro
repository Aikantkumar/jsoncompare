---
import Layout from '../../layouts/Layout.astro';
import JsonCompareApp from '../../components/diff/JsonCompareApp';

const features = [
  {
    title: "Semántico e independiente del orden de claves",
    desc: "Normaliza automáticamente el orden de claves y espacios en blanco. Compara cambios de significado y datos, no el formato estético.",
    badge: "Semántico"
  },
  {
    title: "Alineación de arrays por ID único",
    desc: "Alinea los elementos de array por identificadores (`id`, `uuid`, `key`) para que las filas insertadas no rompan toda la secuencia.",
    badge: "Coincidencia Inteligente"
  },
  {
    title: "Parche RFC 6902 JSON",
    desc: "Exporta parches operativos estándar (add, remove, replace, move) con 1 clic para sincronizar bases de datos o simulaciones de API.",
    badge: "RFC 6902"
  },
  {
    title: "Reparación de sintaxis inteligente en 1 clic",
    desc: "Corrige automáticamente comas finales, comillas simples, claves sin comillas y `True/False/None` de Python al instante antes de comparar.",
    badge: "Auto-fix"
  },
  {
    title: "Consulta de subconjunto JSONPath",
    desc: "Filtra respuestas masivas de 100k líneas solo hasta el nodo objetivo (`$.items[*].sku`) antes de comparar.",
    badge: "JSONPath"
  },
  {
    title: "Privacidad 100% del lado del cliente",
    desc: "Todos los cálculos se ejecutan dentro de tu navegador. Ningún token, credencial ni dato del cliente toca un servidor remoto.",
    badge: "Privado"
  }
];

---

<Layout
  lang="es"
  title="JSON Compare Online — Comparador JSON Semántico, Rápido y Privado"
  description="Compara dos objetos o archivos JSON online con diff semántico, independencia del orden de claves, generación de parches JSON RFC 6902 y privacidad sin subida al servidor."
  keywords="comparador json, comparador json online, herramienta comparar json, json diff, formateador json, validador json, minimizador json, parche json, json a typescript, json key sorter, yaml a json, json a yaml, xml a json, json a xml, csv a json, json a csv"
  activeTab="compare"
  canonicalPath="/"
>
  <!-- Sección Hero -->
  <section class="border-b border-[#e5e5e5] dark:border-[#22242a] bg-white dark:bg-[#000000] pt-8 pb-6 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#1eaa52]"></span>
            Motor semántico de diff JSON • Privacidad 100% del lado del cliente
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase leading-none">
            COMPARADOR JSON SEMÁNTICO ONLINE
          </h1>
          <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl leading-relaxed">
            El moderno <strong>comparador JSON</strong> y analizador de diff semántico. Compara dos cargas JSON lado a lado o unificado, normaliza claves, alinea arrays por ID y exporta parches RFC 6902 sin subir datos a servidores externos.
          </p>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <a
            href="/es/tools/json-formatter"
            class="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#111111] hover:text-white dark:hover:bg-[#f0f0f2] dark:hover:text-[#111111] transition-colors"
          >
            Formateador JSON
          </a>
          <a
            href="/es/tools/json-validator"
            class="px-4 py-2 rounded-full text-xs font-semibold bg-[#f5f5f5] dark:bg-[#18191d] text-[#111111] dark:text-[#f0f0f2] border border-[#cacacb] dark:border-[#2b2d35] hover:bg-[#111111] hover:text-white dark:hover:bg-[#f0f0f2] dark:hover:text-[#111111] transition-colors"
          >
            Validador JSON
          </a>
          <a
            href="/es/tools/json-to-typescript"
            class="px-4 py-2 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors"
          >
            JSON a TypeScript
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Isla interactiva de diff -->
  <section class="bg-white dark:bg-[#000000] transition-colors">
    <JsonCompareApp client:load />
  </section>

  <!-- Cuadrícula de características diferenciadoras -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10 text-center max-w-2xl mx-auto">
      <span class="text-xs font-mono uppercase tracking-widest text-[#707072] dark:text-[#8e8e93]">Diseñado para desarrolladores modernos</span>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#111111] dark:text-[#f0f0f2] mt-1">
        Creado para superar a las herramientas genéricas de diff
      </h2>
      <p class="text-sm text-[#4b4b4d] dark:text-[#9ca3af] mt-2">
        Compara archivos de configuración, depura respuestas de microservicios y genera parches RFC sin falsos positivos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feat) => (
        <div class="p-6 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#cacacb] dark:hover:border-[#383d47] transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-white dark:bg-[#1c1f26] border border-[#cacacb] dark:border-[#2b2d35] text-[#111111] dark:text-[#f0f0f2] font-medium">
                {feat.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-[#111111] dark:text-[#f0f0f2] tracking-tight mb-2">
              {feat.title}
            </h3>
            <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed">
              {feat.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Matriz rápida de herramientas -->
  <section class="bg-[#f5f5f5] dark:bg-[#111215] border-y border-[#e5e5e5] dark:border-[#22242a] py-14 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-[#111111] dark:text-[#f0f0f2]">
            Suite completa de transformación de datos
          </h2>
          <p class="text-xs text-[#707072] dark:text-[#8e8e93] mt-0.5">
            Cambia entre utilidades para desarrolladores sin salir de la pestaña del navegador.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <a href="/es/tools/json-formatter" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">Formateador JSON</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Indentación y embellecimiento</span>
        </a>
        <a href="/es/tools/json-validator" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">Validador JSON</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Diagnóstico de líneas</span>
        </a>
        <a href="/es/tools/json-minifier" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">Minificador JSON</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Eliminador de espacios</span>
        </a>
        <a href="/es/tools/json-patch-generator" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">Parche RFC 6902</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Diffs operativos</span>
        </a>
        <a href="/es/tools/json-to-typescript" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">JSON a TS</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Generador de tipos</span>
        </a>
        <a href="/es/convert/yaml-to-json" class="p-4 rounded-xl bg-white dark:bg-[#16181d] border border-[#e5e5e5] dark:border-[#22242a] hover:border-[#111111] dark:hover:border-[#f0f0f2] transition-all group">
          <span class="text-xs font-bold text-[#111111] dark:text-[#f0f0f2] block group-hover:underline">YAML ⇄ JSON</span>
          <span class="text-[11px] text-[#707072] dark:text-[#8e8e93] mt-1 block">Convertidor de configuración</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Guía completa de SEO (800 - 1200 palabras) -->
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-[#39393b] dark:text-[#d1d5db]">
    <div class="space-y-12">
      <!-- Sección 1: Introducción al diff semántico JSON -->
      <header class="space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-xs font-mono text-[#39393b] dark:text-[#b5b5b8] border border-[#e5e5e5] dark:border-[#22242a]">
          Guía completa para desarrolladores
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2]">
          Entendiendo JSON Compare: Por qué el diff semántico supera a las herramientas de texto plano
        </h2>
        <p class="text-sm sm:text-base leading-relaxed">
          En ingeniería de software, arquitecturas distribuidas y desarrollo de APIs, comparar datos estructurados es una tarea cotidiana. Sin embargo, los desarrolladores frecuentemente enfrentan falsos positivos al confiar en utilidades de diff tradicionales como Git diff o Unix diff. Un diff de texto plano trata los documentos como secuencias de caracteres. Si un punto final REST devuelve un objeto con valores idénticos pero claves reordenadas, o usa tabulaciones en lugar de espacios, una comparación de texto marca cada línea como modificada. Aquí es donde un <strong>comparador JSON</strong> y una <strong>herramienta JSON online</strong> dedicada se vuelven indispensables.
        </p>
        <p class="text-sm sm:text-base leading-relaxed">
          Nuestra <strong>herramienta JSON online</strong> implementa comparación de árbol semántico. En lugar de inspeccionar posiciones de caracteres, nuestro motor de diff parsea ambas entradas en un Árbol de Sintaxis Abstracta (AST), reconcilia nodos estructurales y realiza un <strong>diff JSON profundo</strong>. Ya sea que estés depurando incompatibilidades de contratos de microservicios, validando dumps de bases de datos staging vs producción, o rastreando cambios de estado en almacenes Redux del frontend, el diff semántico expone adiciones, eliminaciones y modificaciones de valor reales ignorando variaciones arbitrarias de espacios en blanco, indentación y orden de claves.
        </p>
      </header>

      <!-- Sección 2: Capacidades principales -->
      <section class="space-y-4">
        <h3 class="text-xl font-bold text-[#111111] dark:text-[#f0f0f2]">
          Capacidades principales del motor de diff JSON definitivo
        </h3>
        <p class="text-sm leading-relaxed">
          Diseñado desde cero para flujos de trabajo de desarrolladores modernos, esta <strong>herramienta JSON</strong> resuelve los casos extremos más difíciles en comparación de datos estructurados:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
          <div class="p-5 rounded-xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
            <h4 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2] mb-1">Normalización profunda de claves</h4>
            <p class="text-xs leading-relaxed text-[#4b4b4d] dark:text-[#9ca3af]">
              Los objetos JSON son colecciones clave-valor desordenadas por especificación. Nuestro <strong>ordenador de claves JSON</strong> automatizado ordena recursivamente todas las claves de los objetos alfabéticamente en cada jerarquía anidada antes de calcular la diferencia, eliminando cambios falsos causados por peculiaridades de serialización.
            </p>
          </div>
          <div class="p-5 rounded-xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
            <h4 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2] mb-1">Coincidencia inteligente de elementos de array por clave</h4>
            <p class="text-xs leading-relaxed text-[#4b4b4d] dark:text-[#9ca3af]">
              Las herramientas de diff tradicionales fallan cuando se inserta un elemento al inicio de un array porque todos los índices siguientes se desplazan en uno. Nuestro motor permite coincidir elementos de array por propiedades identificadoras únicas como `id`, `uuid` o `slug`, manteniendo los registros coincidentes perfectamente alineados.
            </p>
          </div>
        </div>
      </section>

      <!-- Sección 3: Utilidades esenciales para desarrolladores -->
      <section class="space-y-6">
        <h3 class="text-xl font-bold text-[#111111] dark:text-[#f0f0f2]">
          Suite completa para desarrolladores JSON: Formatear, validar, minimizar y transformar
        </h3>
        <p class="text-sm leading-relaxed">
          Si bien el <strong>comparador JSON</strong> es el centro de nuestra plataforma, la ingeniería de software implica múltiples manipulaciones diarias de cargas de datos. Por eso ofrecemos un ecosistema interconectado de herramientas rápidas del lado del cliente diseñadas para optimizar tu ciclo de desarrollo:
        </p>
        <div class="space-y-4">
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-formatter" class="hover:underline">Formateador y embellecedor JSON</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Al lidiar con salidas de API compactas o registros desordenados, nuestro <a href="/es/tools/json-formatter" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">formateador JSON</a> online da formato e indentación inmediata a tus cargas JSON. Elige entre sangría de 2 espacios, 4 espacios o tabulación con coloreado de sintaxis y plegado automático de estructura.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-validator" class="hover:underline">Validador JSON y diagnóstico de sintaxis en tiempo real</a>
            </h4>
            <p class="text-xs leading-relaxed">
              JSON no válido bloqueará parsers y pasarelas API posteriores. Nuestro <a href="/es/tools/json-validator" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">validador JSON</a> señala errores de sintaxis hasta el número exacto de fila y columna, destacando claves sin comillas, comas extra o corchetes sin cerrar, y proporciona reparación de sintaxis automática con 1 clic.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-minifier" class="hover:underline">Minificador JSON y utilidad de compresión</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Antes de implementar configuraciones en entornos de producción o enviar cargas útiles a través de canales de red de bajo ancho de banda, reduzca el tamaño de los documentos con nuestro <a href="/es/tools/json-minifier" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">minificador JSON</a>. Elimina espacios en blanco, retornos de carro y saltos de línea sin alterar la integridad semántica de los datos.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-patch-generator" class="hover:underline">Generador de parches RFC 6902 JSON</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Genere documentos de parche estandarizados para representar actualizaciones atómicas entre dos objetos usando nuestro generador dedicado de <a href="/es/tools/json-patch-generator" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">parches JSON</a>. Ideal para crear cuerpos de solicitud HTTP PATCH RESTful, probar respuestas delta de microservicios y construir sistemas de captura de eventos similares a Git.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-to-typescript" class="hover:underline">Generador de definiciones de tipo TypeScript de JSON</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Elimine la creación de plantillas de interfaces TypeScript. Pegue cualquier carga de muestra de API en nuestro generador de <a href="/es/tools/json-to-typescript" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">JSON a TypeScript</a> para sintetizar al instante interfaces TS fuertemente tipadas, alias de tipo y tipos anidados opcionales con la nulabilidad de campo correcta.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-escape-unescape" class="hover:underline">Herramienta de escape y unescape de cadena JSON</a>
            </h4>
            <p class="text-xs leading-relaxed">
              ¿Cansado de barras invertidas, comillas y caracteres de salto de línea con doble escape en columnas de cadenas de base de datos? Use nuestro conversor de <a href="/es/tools/json-escape-unescape" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">escape/unescape</a> (también buscado comúnmente como <a href="/es/tools/json-escape-unescape" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">escapre/unescape</a>) para convertir JSON stringificado en sintaxis limpia y legible, o escapar JSON sin procesar para incrustarlo dentro de cadenas.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-schema-validator" class="hover:underline">Validador de esquema JSON (Draft-07 y 2020-12)</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Verifique el cumplimiento del contrato para cuerpos de solicitud de API y archivos de configuración contra esquemas estandarizados. Nuestro <a href="/es/tools/json-schema-validator" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">validador de esquema JSON</a> proporciona validación de esquemas de alto rendimiento que admite las especificaciones Draft-07 y Draft 2020-12.
            </p>
          </div>
          <div class="border-l-2 border-[#111111] dark:border-[#f0f0f2] pl-4 space-y-1">
            <h4 class="text-sm font-bold text-[#111111] dark:text-[#f0f0f2]">
              <a href="/es/tools/json-sorter" class="hover:underline">Ordenador de claves JSON</a>
            </h4>
            <p class="text-xs leading-relaxed">
              Estandarice estructuras de carga desordenadas con nuestro ordenador independiente de <a href="/es/tools/json-sorter" class="text-[#111111] dark:text-[#f0f0f2] font-semibold underline">claves JSON</a>. Ordena profundamente las claves en orden alfabético ascendente o descendente, haciendo que las comparaciones de versiones y las revisiones de código sean limpias y sin esfuerzo.
            </p>
          </div>
        </div>
      </section>

      <!-- Sección 4: Convertidores de serialización multiformato -->
      <section class="space-y-4">
        <h3 class="text-xl font-bold text-[#111111] dark:text-[#f0f0f2]">
          Convertidores bidireccionales de formatos: YAML, XML y CSV
        </h3>
        <p class="text-sm leading-relaxed">
          Las pilas de ingeniería modernas rara vez existen en un vacío solo de JSON. Las configuraciones de infraestructura en la nube a menudo dependen de YAML, los sistemas empresariales heredados consumen XML y los canales de informes comerciales generan CSV tabulares. Nuestra plataforma ofrece convertidores bidireccionales de alta precisión:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-6">
          <div class="p-4 rounded-xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
            <h4 class="font-bold text-xs uppercase text-[#111111] dark:text-[#f0f0f2] mb-1">Conversión YAML</h4>
            <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed mb-2">
              Traduzca configuraciones de Kubernetes, GitHub Actions y OpenAPI entre estructuras de serialización.
            </p>
            <div class="flex gap-2 text-xs">
