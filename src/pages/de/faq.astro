---
import Layout from '../../layouts/Layout.astro';
const breadcrumbSchema = { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [ { "@type": "ListItem", position: 1, name: "Startseite", item: "https://jsoncompareonline.com/de" }, { "@type": "ListItem", position: 2, name: "FAQ", item: "https://jsoncompareonline.com/de/faq" } ] };
const faqs = [
  { q: "zwei JSON-Dateien vergleichen", a: "Fügen Sie Ihre Basisdatei (Links) und geänderte Datei (Rechts) in unsere Online-JSON-Vergleichs-Editoren ein, oder klicken Sie auf „Datei laden“, um .json-Dateien von Ihrem Computer zu importieren. Aktivieren Sie „Schlüssel sortieren“, um die Schlüsselreihenfolge zu ignorieren, und führen Sie den Diff aus. Hinzugefügte Schlüssel erscheinen grün, entfernte Eigenschaften rot und geänderte Werte bernsteinfarben. Wechseln Sie zwischen Seiten-an-Seiten- und Einheitsansicht, und exportieren Sie einen RFC 6902 JSON-Patch mit einem Klick für alle erkannten Änderungen." },
  { q: "Was ist ein JSON-Unterschied?", a: "Ein JSON-Unterschied (JSON diff) ist der Vorgang, zwei JSON-Dokumente zu vergleichen, um genau festzustellen, was sich geändert hat — hinzugefügte Schlüssel, entfernte Schlüssel, geänderte Werte, Typänderungen und Array-Einfügungen oder -Löschungen. Ein semantischer JSON-Diff analysiert die Dokumentstruktur, anstatt es als reinen Text zu behandeln, sodass umsortierte Schlüssel, Leerzeichenänderungen und Einrückungsunterschiede keine Falschpositive auslösen." },
  { q: "Wofür eignet sich JSON am besten?", a: "JSON (JavaScript Object Notation) eignet sich am besten für den leichten Datenaustausch zwischen Web-Clients und Servern, REST-API-Anfrage- und Antwort-Nutzlasten, Konfigurationsdateien wie package.json und tsconfig.json, NoSQL-Dokumentspeicherung und Frontend-Anwendungszustand. Es ist sprachunabhängig, menschenlesbar und wird von jeder modernen Programmiersprache nativ unterstützt." }
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(faq => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })) };
---
<Layout lang="de" title="JSON Compare FAQ | JSON Compare Online" description="Häufig gestellte Fragen zu unserem semantischen JSON-Vergleichstool, RFC 6902-Patches, JSON-Schlüssel-Sortierer, clientseitiger Privatsphäre und JSON-Konverter." keywords="json compare faq, json vergleichen online, wie vergleiche ich json dateien, json unterschied, json vergleichstool, rfc 6902 json patch, json key sorter, json zu typescript, json konverter, clientseitiger json vergleich" canonicalPath="/faq" activeTab="faq" structuredData={[breadcrumbSchema, faqSchema]}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#cacacb]/40 dark:border-[#272a30]"><span class="w-1.5 h-1.5 rounded-full bg-[#007d48] dark:bg-[#34d399]"></span>Hilfezentrum</div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">HÄUFIG GESTELLTE FRAGEN</h1>
      <p class="mt-2 text-sm sm:text-base text-[#4b4b4d] dark:text-[#9ca3af]">Alles, was Sie über unsere semantischen Diff-Algorithmen, Entwickler-Tools, Sicherheitsarchitektur und Datenkonverter wissen müssen.</p>
    </div>
    <section class="space-y-4">{faqs.map((faq) => (<details class="group bg-white dark:bg-[#14161b] rounded-2xl border border-[#e5e5e5] dark:border-[#22242a] p-5 [&_summary::-webkit-details-marker]:hidden cursor-pointer"><summary class="flex items-center justify-between font-semibold text-sm text-[#111111] dark:text-[#f0f0f2]"><span>{faq.q}</span><span class="ml-4 text-[#707072] dark:text-[#8e8e93] group-open:rotate-180 transition-transform"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></span></summary><p class="mt-3 text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed border-t border-[#f5f5f5] dark:border-[#202228] pt-3">{faq.a}</p></details>))}</section>
    <section class="mt-12 p-6 sm:p-8 rounded-2xl border border-[#111111] dark:border-[#f0f0f2] flex flex-col sm:flex-row items-center justify-between gap-4"><div><h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2]">Bereit, JSON zu vergleichen?</h3><p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] mt-0.5">Vergleichen Sie sofort zwei JSON-Nutzlasten — 100 % clientseitig, ohne Uploads.</p></div><a href="/de/" class="px-5 py-2.5 rounded-full text-xs font-semibold bg-[#111111] text-white hover:bg-[#39393b] dark:bg-[#f0f0f2] dark:text-[#111111] dark:hover:bg-white transition-colors shrink-0">JSON-Vergleichstool öffnen</a></section>
  </div>
</Layout>
