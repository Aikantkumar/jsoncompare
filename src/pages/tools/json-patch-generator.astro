---
import Layout from '../../layouts/Layout.astro';
import JsonPatchGeneratorApp from '../../components/tools/JsonPatchGeneratorApp';
---

<Layout
  title="RFC 6902 JSON Patch Generator — Calculate Operational Diff Mutations"
  description="Generate standard RFC 6902 JSON Patch operations (add, remove, replace, move, copy) between any two JSON objects."
  activeTab="tools"
  canonicalPath="/tools/json-patch-generator"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] text-[11px] font-mono text-[#39393b] mb-3 border border-[#e5e5e5]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111]"></span>
        IETF Standard
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] uppercase">
        RFC 6902 JSON PATCH GENERATOR
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] max-w-2xl">
        Compute the exact sequence of JSON Patch operations required to transform a source JSON document into a target document. Ideal for REST API PATCH endpoints and database replication.
      </p>
    </div>

    <JsonPatchGeneratorApp client:load />
  </div>
</Layout>

