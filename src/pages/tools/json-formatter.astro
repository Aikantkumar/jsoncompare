---
import Layout from '../../layouts/Layout.astro';
import JsonFormatterApp from '../../components/tools/JsonFormatterApp';
---

<Layout
  title="Online JSON Formatter & Beautifier — Free, Private & Instant Indent"
  description="Format, prettify, and sort JSON keys online with custom indentation (2-space, 4-space, tab) and automatic syntax error repair."
  activeTab="tools"
  canonicalPath="/tools/json-formatter"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] text-[11px] font-mono text-[#39393b] mb-3 border border-[#e5e5e5]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111]"></span>
        Developer Utility
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] uppercase">
        JSON FORMATTER & BEAUTIFIER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] max-w-2xl">
        Clean up compact, minified, or disorganized JSON. Configurable spacing, deep alphabetical key sorting, and 1-click syntax auto-repair. Runs 100% locally in your browser.
      </p>
    </div>

    <JsonFormatterApp client:load />

    <!-- How it works & SEO content -->
    <div class="mt-14 max-w-3xl space-y-6 text-xs text-[#4b4b4d] leading-relaxed">
      <h2 class="text-lg font-bold text-[#111111]">Why Format JSON Online?</h2>
      <p>
        When working with microservices, API logs, and database extracts, JSON is often minified or stripped of whitespace to reduce payload transfer size. Our JSON Formatter restores human readability, highlights structural nesting, and validates compliance with RFC 8259 without sending your data to external servers.
      </p>
    </div>
  </div>
</Layout>

