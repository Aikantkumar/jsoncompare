---
import Layout from '../../layouts/Layout.astro';
import JsonSorterApp from '../../components/tools/JsonSorterApp';

const sorterUseCases = [
  {
    title: "Deterministic Git Diffs",
    desc: "Unordered JSON object keys cause noisy git merge conflicts. Sorting keys alphabetically produces clean, reproducible version control commits."
  },
  {
    title: "Cryptographic Hashing & Signing",
    desc: "When generating MD5/SHA256 checksums or cryptographic signatures (like JWTs or HMAC payloads), canonical key order is essential to ensure deterministic output."
  },
  {
    title: "Cache Key Standardization",
    desc: "Query payloads with identical parameters in different orders should hit the same Redis or CDN cache. Key sorting canonicalizes the cache key."
  }
];
---

<Layout
  title="Online JSON Key Sorter — Alphabetical & Deep Key Ordering Tool"
  description="Sort JSON keys alphabetically (A-Z or Z-A) or by key length online. Features deep recursive sorting for deterministic hashing and cleaner Git diffs."
  activeTab="tools"
  canonicalPath="/tools/json-sorter"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#f5f5f5] dark:bg-[#16181d] text-[11px] font-mono text-[#39393b] dark:text-[#b5b5b8] mb-3 border border-[#e5e5e5] dark:border-[#22242a]">
        <span class="w-1.5 h-1.5 rounded-full bg-[#111111] dark:bg-[#f0f0f2]"></span>
        Canonical Serialization
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#111111] dark:text-[#f0f0f2] uppercase">
        JSON KEY SORTER
      </h1>
      <p class="mt-2 text-sm text-[#4b4b4d] dark:text-[#9ca3af] max-w-2xl">
        Alphabetize and order JSON object keys recursively. Standardize payloads for deterministic hashing, cleaner git version control diffs, and predictable API responses.
      </p>
    </div>

    <JsonSorterApp client:load />

    <!-- Why Sort Keys -->
    <div class="mt-16 max-w-4xl">
      <h2 class="text-xl font-bold tracking-tight text-[#111111] dark:text-[#f0f0f2] mb-6">
        Common Use Cases for Canonical JSON Key Sorting
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {sorterUseCases.map((uc) => (
          <div class="p-5 rounded-2xl bg-[#f5f5f5] dark:bg-[#14161b] border border-[#e5e5e5] dark:border-[#22242a]">
            <h3 class="font-bold text-sm text-[#111111] dark:text-[#f0f0f2] mb-2">{uc.title}</h3>
            <p class="text-xs text-[#4b4b4d] dark:text-[#9ca3af] leading-relaxed">{uc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
